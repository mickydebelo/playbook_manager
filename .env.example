# ---- App ----
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# ---- Database ----
# Leave DATABASE_URL empty to use the embedded PGlite database in PGLITE_DATA_DIR (no Docker needed).
# Set it to a PostgreSQL 16+ connection string (with the pgvector extension available) for staging/production.
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite

# ---- Sessions / auth ----
# 32+ random bytes, base64 or hex. Used to sign the session cookie (HS256).
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12
# dev  = local sign-in as a seeded user (never enable in production)
# oidc = corporate SSO (Microsoft Entra ID or Autodesk ID) via OpenID Connect
AUTH_PROVIDER=dev
DEV_LOGIN_ENABLED=true
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Comma-separated e-mail addresses granted the admin role on first sign-in.
BOOTSTRAP_ADMIN_EMAILS=

# ---- Autodesk Platform Services: AI gateway (see docs/APS_REST_API.md) ----
APS_BASE_URL=https://developer-stg.api.autodesk.com
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_MODEL_FAST=amp-pid-1728-anthropic-claude-haiku-4-5-20251001-v1-0
APS_MODEL_QUALITY=amp-pid-1728-anthropic-claude-opus-4-1-20250805-v1-0
APS_EMBED_MODEL=amp-pid-1728-amazon-titan-embed-text-v2-0

# ---- File storage ----
# local = ./.data/storage on disk (development). s3 = S3-compatible bucket (production).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Background jobs ----
# inline = run jobs in the web process (development, tests). worker = separate `npm run worker` process.
JOBS_MODE=inline

# ---- PDF export ----
# Browser binary used to print the PDF. Empty = the usual macOS and Linux locations are tried.
CHROME_PATH=

# ---- Knowledge library ingest ----
# Watched folder for local-folder ingest. Never derived from a request.
INGEST_LOCAL_DIR=./.data/ingest
# SharePoint ingest through Microsoft Graph. Needs Sites.ReadWrite.All and Files.ReadWrite.All.
# Unverified: no credentials exist yet, so the connector fails with a clear message until they do.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
